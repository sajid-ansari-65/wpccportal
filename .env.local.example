# Copy this to .env.local for local dev, and add the same to Vercel → Project → Settings → Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-settings-api

# The password volunteers/admin will use to log in to /dashboard
ADMIN_PASSWORD=choose-a-strong-password
