# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Local development uses the stack from `supabase start`, which prints these
# values. Production uses the real project's values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The new app uses this in exactly ONE place (lib/checkin.ts, the
# anonymous public check-in path) so there is a single importer to audit.
# It must never reach the browser and never be pasted into chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- Legacy -----------------------------------------------------------------
# Not read by this app. It stays set in the Vercel project because a rollback
# to the pre-cutover deployment needs it to authenticate anyone at all.
# ADMIN_PASSWORD=
